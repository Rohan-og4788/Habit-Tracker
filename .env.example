# HabitForge — environment variables
# Copy this file to .env and fill in your values.
# Never commit a real .env file.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
# MongoDB connection string (Atlas or self-hosted).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/habitforge?retryWrites=true&w=majority
MONGODB_DB_NAME=habitforge

# Secret used to HMAC verification/reset tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=replace-with-a-long-random-secret

# Public application URL. Used for metadata, sitemap and email links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Email (optional) — verification, password reset and contact form.
# When RESEND_API_KEY is missing these features return a clear setup message.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com
CONTACT_EMAIL=support@yourdomain.com

# ---------------------------------------------------------------------------
# Reminder cron (optional)
# Vercel Cron sends this value as a Bearer token.
# ---------------------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------------------
# Web Push (optional) — generate with: npx web-push generate-vapid-keys
# When missing, the notifications page disables browser push.
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@yourdomain.com

# ---------------------------------------------------------------------------
# AI coach (optional)
# When missing, the coach uses deterministic local analysis.
# ---------------------------------------------------------------------------
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Stripe billing (optional)
# When missing, upgrades return a setup message and the free plan stays usable.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=

# ---------------------------------------------------------------------------
# Image uploads (optional) — not enabled in this build.
# Profile avatars accept a public URL until an upload provider is configured.
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Error monitoring (optional) — not enabled in this build.
# ---------------------------------------------------------------------------
SENTRY_DSN=

# ---------------------------------------------------------------------------
# Seed script (optional overrides)
# ---------------------------------------------------------------------------
SEED_EMAIL=demo@habitforge.app
SEED_PASSWORD=Demo1234!

# ---------------------------------------------------------------------------
# End-to-end tests (optional, test-only — never needed in production)
# E2E_EMAIL / E2E_PASSWORD sign in during the authenticated Playwright test.
# E2E_BASE_URL reuses an already-running server (local or staging) instead of
# letting Playwright start `npm run dev`.
# ---------------------------------------------------------------------------
# E2E_EMAIL=demo@habitforge.app
# E2E_PASSWORD=Demo1234!
# E2E_BASE_URL=http://localhost:3000

# Runtime
NODE_ENV=development
